# OpenLid local / testnet config. Names only — fill values in a private .env
# that is never committed. No seed phrases, private keys, or full-access keys
# belong in this repo, in logs, or in this file.

# testnet only for this demo. Never mainnet. $0 spend; no paid APIs.
OPENLID_NETWORK=testnet

# NEAR JSON-RPC URL. Leave empty for the testnet default (https://rpc.testnet.fastnear.com);
# the official rpc.testnet.near.org is deprecated and answers HTTP 429.
OPENLID_NEAR_RPC_URL=

# Treasury contract account on that network
OPENLID_CONTRACT_ID=

# Church treasurer / owner account (hardware wallet or multisig in real use)
OPENLID_OWNER_ACCOUNT_ID=

# Agent account. Use a function-call access key limited to request_payout.
OPENLID_AGENT_ACCOUNT_ID=

# Absolute path to a local key file for the agent's function-call key.
# The file stays on the operator's machine, not in this repository.
OPENLID_AGENT_KEY_FILE=

# Optional. Absolute path to a local owner key file for demo approve/reject only.
# In real use the treasurer signs on a hardware wallet or multisig. Never commit.
OPENLID_OWNER_KEY_FILE=

# NEP-141 test FT account id on testnet (not mainnet USDC)
OPENLID_USDC_TOKEN_ID=

# 1Click API (https://docs.near-intents.org). Tests mock this. Do not use
# mainnet funds. Put the real key only in your private .env.
# 1Click is mainnet-only. The demo uses dry-run quotes only and never
# sends a deposit. Leave the key empty so the $0 demo does not call a paid API.
ONECLICK_BASE_URL=https://1click.chaindefuser.com
# Leave empty for the $0 demo (no live 1Click call).
ONECLICK_API_KEY=

# Always true for this demo. The client refuses dry: false.
ONECLICK_DRY_RUN=true

# Gitignored directory created at demo time for testnet keys. Never commit.
# The demo must not print key material to logs or stdout.
OPENLID_DEMO_KEYS_DIR=.demo-keys

# Local data dir for the API (gifts, cached status). Not committed.
OPENLID_DATA_DIR=./data

# HTTP
OPENLID_API_HOST=127.0.0.1
OPENLID_API_PORT=8787
